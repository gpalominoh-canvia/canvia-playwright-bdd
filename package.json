{
  "name": "e2e-bdd-playwright",
  "version": "1.0.0",
  "description": "Proyecto base: Playwright + TypeScript + Cucumber",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--import=tsx cucumber-js",
    "test:smoke": "cross-env NODE_OPTIONS=--import=tsx cucumber-js --tags @smoke",
    "typecheck": "tsc --noEmit",
    "test:headed": "cross-env HEADED=1 NODE_OPTIONS=--import=tsx cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
